#!/bin/sh /etc/rc.common

USE_PROCD=1

START=95
STOP=01

CONFIGURATION=AdGuardHome
CRON_FILE=/etc/crontabs/root
EXTRA_COMMANDS="do_redirect testbackup test_crontab force_reload isrunning"
EXTRA_HELP="        do_redirect 0 or 1\
        testbackup backup or restore\
		test_crontab
		force_reload
		isrunning"
set_forward_dnsmasq()
{
	local PORT="$1"
	addr="127.0.0.1#$PORT"
	OLD_SERVER="`uci get dhcp.@dnsmasq[0].server 2>/dev/null`"
	echo $OLD_SERVER | grep "^$addr" >/dev/null 2>&1
	if [ $? -eq 0 ]; then
		return
	fi
	uci delete dhcp.@dnsmasq[0].server 2>/dev/null
	uci add_list dhcp.@dnsmasq[0].server=$addr
	for server in $OLD_SERVER; do
		if [ "$server" = "$addr" ]; then
			continue
		fi
		uci add_list dhcp.@dnsmasq[0].server=$server
	done
	uci delete dhcp.@dnsmasq[0].resolvfile 2>/dev/null
	uci set dhcp.@dnsmasq[0].noresolv=1
	uci commit dhcp
	/etc/init.d/dnsmasq restart
}

stop_forward_dnsmasq()
{
	local OLD_PORT="$1"
	addr="127.0.0.1#$OLD_PORT"
	OLD_SERVER="`uci get dhcp.@dnsmasq[0].server 2>/dev/null`"
	echo $OLD_SERVER | grep "^$addr" >/dev/null 2>&1
	if [ $? -ne 0 ]; then
		return
	fi

	uci del_list dhcp.@dnsmasq[0].server=$addr 2>/dev/null
	addrlist="`uci get dhcp.@dnsmasq[0].server 2>/dev/null`"
	if [ -z "$addrlist" ] ; then
		uci set dhcp.@dnsmasq[0].resolvfile=/tmp/resolv.conf.auto 2>/dev/null
		uci delete dhcp.@dnsmasq[0].noresolv 2>/dev/null
	fi
	uci commit dhcp
	/etc/init.d/dnsmasq restart
}

set_iptable()
{
	local ipv6_server=$1
	local tcp_server=$2
	local comment="-m comment --comment 'AdGuardHome_DNS_Redirect'"
	logger -t AdGuardHome "Debug: set_iptable called with ipv6_server=$ipv6_server, tcp_server=$tcp_server, AdGuardHome_PORT=$AdGuardHome_PORT"
	uci -q batch <<-EOF >/dev/null 2>&1
  delete firewall.AdGuardHome
	set firewall.AdGuardHome=include
	set firewall.AdGuardHome.type=script
	set firewall.AdGuardHome.path=/usr/share/AdGuardHome/firewall.start
	set firewall.AdGuardHome.reload=1
	commit firewall
EOF

	if command -v nft >/dev/null 2>&1 && nft list tables >/dev/null 2>&1; then
		logger -t AdGuardHome "Debug: Using nftables"
		set_nftable $ipv6_server $tcp_server
		return
	fi

	logger -t AdGuardHome "Debug: Using iptables"
	if [ "$tcp_server" == "1" ]; then
		iptables -t nat -C PREROUTING -p tcp --dport 53 -j REDIRECT --to-ports $AdGuardHome_PORT $comment >/dev/null 2>&1
		if [ $? -ne 0 ]; then
			logger -t AdGuardHome "Debug: Adding iptables TCP redirect rule for port $AdGuardHome_PORT"
			iptables -t nat -A PREROUTING -p tcp --dport 53 -j REDIRECT --to-ports $AdGuardHome_PORT $comment >/dev/null 2>&1
		fi
	fi
	iptables -t nat -C PREROUTING -p udp --dport 53 -j REDIRECT --to-ports $AdGuardHome_PORT $comment >/dev/null 2>&1
	if [ $? -ne 0 ]; then
		logger -t AdGuardHome "Debug: Adding iptables UDP redirect rule for port $AdGuardHome_PORT"
		iptables -t nat -A PREROUTING -p udp --dport 53 -j REDIRECT --to-ports $AdGuardHome_PORT $comment >/dev/null 2>&1
	fi

	if [ "$ipv6_server" == 0 ]; then
		return
	fi

	if [ "$tcp_server" == "1" ]; then
		ip6tables -t nat -C PREROUTING -p tcp --dport 53 -j REDIRECT --to-ports $AdGuardHome_PORT $comment >/dev/null 2>&1
		if [ $? -ne 0 ]; then
			logger -t AdGuardHome "Debug: Adding ip6tables TCP redirect rule for port $AdGuardHome_PORT"
			ip6tables -t nat -A PREROUTING -p tcp --dport 53 -j REDIRECT --to-ports $AdGuardHome_PORT $comment >/dev/null 2>&1
		fi
	fi
	ip6tables -t nat -C PREROUTING -p udp --dport 53 -j REDIRECT --to-ports $AdGuardHome_PORT $comment >/dev/null 2>&1
	if [ $? -ne 0 ]; then
		logger -t AdGuardHome "Debug: Adding ip6tables UDP redirect rule for port $AdGuardHome_PORT"
		ip6tables -t nat -A PREROUTING -p udp --dport 53 -j REDIRECT --to-ports $AdGuardHome_PORT $comment >/dev/null 2>&1
	fi
	logger -t AdGuardHome "Info: Firewall redirect rules added successfully with comment"

}

set_nftable()
{
	local ipv6_server=$1
	local tcp_server=$2
	local comment="comment \"AdGuardHome_DNS_Redirect\""
	logger -t AdGuardHome "Debug: set_nftable called with ipv6=$ipv6_server, tcp=$tcp_server, port=$AdGuardHome_PORT"

	nft list tables ip 2>/dev/null | grep -q "nat" || nft add table ip nat 2>/dev/null
	nft list chains ip nat 2>/dev/null | grep -q "PREROUTING" || nft add chain ip nat PREROUTING '{ type nat hook prerouting priority -100; }' 2>/dev/null
	nft list chains ip nat 2>/dev/null | grep -q "POSTROUTING" || nft add chain ip nat POSTROUTING '{ type nat hook postrouting priority 100; }' 2>/dev/null

	logger -t AdGuardHome "Debug: Adding IPv4 nftables rules"
	if [ "$tcp_server" == "1" ]; then
		nft list chain ip nat PREROUTING 2>/dev/null | grep -q "tcp dport 53 comment \"AdGuardHome_DNS_Redirect\"" || \
			nft add rule ip nat PREROUTING tcp dport 53 redirect to :$AdGuardHome_PORT $comment >/dev/null 2>&1
		logger -t AdGuardHome "Debug: Added IPv4 TCP nftable rule"
	fi
	nft list chain ip nat PREROUTING 2>/dev/null | grep -q "udp dport 53 comment \"AdGuardHome_DNS_Redirect\"" || \
		nft add rule ip nat PREROUTING udp dport 53 redirect to :$AdGuardHome_PORT $comment >/dev/null 2>&1
	logger -t AdGuardHome "Debug: Added IPv4 UDP nftable rule"

	# 只有在启用 IPv6 时才添加 IPv6 规则
	if [ "$ipv6_server" != "0" ]; then
		logger -t AdGuardHome "Debug: Adding IPv6 nftables rules"
		nft list tables ip6 2>/dev/null | grep -q "nat" || nft add table ip6 nat 2>/dev/null
		nft list chains ip6 nat 2>/dev/null | grep -q "PREROUTING" || nft add chain ip6 nat PREROUTING '{ type nat hook prerouting priority -100; }' 2>/dev/null

		if [ "$tcp_server" == "1" ]; then
			nft list chain ip6 nat PREROUTING 2>/dev/null | grep -q "tcp dport 53 comment \"AdGuardHome_DNS_Redirect\"" || \
				nft add rule ip6 nat PREROUTING tcp dport 53 redirect to :$AdGuardHome_PORT $comment >/dev/null 2>&1
			logger -t AdGuardHome "Debug: Added IPv6 TCP nftable rule"
		fi
		nft list chain ip6 nat PREROUTING 2>/dev/null | grep -q "udp dport 53 comment \"AdGuardHome_DNS_Redirect\"" || \
			nft add rule ip6 nat PREROUTING udp dport 53 redirect to :$AdGuardHome_PORT $comment >/dev/null 2>&1
		logger -t AdGuardHome "Debug: Added IPv6 UDP nftable rule"
	else
		logger -t AdGuardHome "Debug: Skipping IPv6 rules (disabled)"
	fi
}

clear_iptable()
{
	uci -q batch <<-EOF >/dev/null 2>&1
  delete firewall.AdGuardHome
	commit firewall
EOF
	local OLD_PORT="$1"
	local ipv6_server=$2
	local comment="--comment 'AdGuardHome_DNS_Redirect'"
	logger -t AdGuardHome "Debug: Clearing iptables rules for port $OLD_PORT with comment"

	if command -v nft >/dev/null 2>&1 && nft list tables >/dev/null 2>&1; then
		clear_nftable $OLD_PORT $ipv6_server
	else
		while iptables -t nat -C PREROUTING -p udp --dport 53 -j REDIRECT $comment >/dev/null 2>&1; do
			iptables -t nat -D PREROUTING -p udp --dport 53 -j REDIRECT $comment >/dev/null 2>&1
			logger -t AdGuardHome "Debug: Deleted IPv4 UDP rule"
		done
		
		while iptables -t nat -C PREROUTING -p tcp --dport 53 -j REDIRECT $comment >/dev/null 2>&1; do
			iptables -t nat -D PREROUTING -p tcp --dport 53 -j REDIRECT $comment >/dev/null 2>&1
			logger -t AdGuardHome "Debug: Deleted IPv4 TCP rule"
		done

		if [ "$ipv6_server" != 0 ]; then
			while ip6tables -t nat -C PREROUTING -p udp --dport 53 -j REDIRECT $comment >/dev/null 2>&1; do
				ip6tables -t nat -D PREROUTING -p udp --dport 53 -j REDIRECT $comment >/dev/null 2>&1
				logger -t AdGuardHome "Debug: Deleted IPv6 UDP rule"
			done
			
			while ip6tables -t nat -C PREROUTING -p tcp --dport 53 -j REDIRECT $comment >/dev/null 2>&1; do
				ip6tables -t nat -D PREROUTING -p tcp --dport 53 -j REDIRECT $comment >/dev/null 2>&1
				logger -t AdGuardHome "Debug: Deleted IPv6 TCP rule"
			done
		fi
	fi
	logger -t AdGuardHome "Info: Firewall rules cleared successfully using comment"
}

clear_nftable()
{
	local OLD_PORT="$1"
	local ipv6_server=$2
	
	logger -t AdGuardHome "Debug: Clearing nftables rules"
	
	# 总是清理 IPv4 规则
	logger -t AdGuardHome "Debug: Clearing IPv4 nftables rules"
	while :; do
		local handle=$(nft -a list chain ip nat PREROUTING 2>/dev/null | grep -E "udp.*dport.*53.*redirect to.*:$OLD_PORT.*comment \"AdGuardHome_DNS_Redirect\"" | grep -oE "handle [0-9]+" | head -1 | awk '{print $2}')
		[ -z "$handle" ] && break
		nft delete rule ip nat PREROUTING handle $handle 2>/dev/null
		logger -t AdGuardHome "Debug: Deleted IPv4 UDP nftable rule"
	done
	
	while :; do
		local handle=$(nft -a list chain ip nat PREROUTING 2>/dev/null | grep -E "tcp.*dport.*53.*redirect to.*:$OLD_PORT.*comment \"AdGuardHome_DNS_Redirect\"" | grep -oE "handle [0-9]+" | head -1 | awk '{print $2}')
		[ -z "$handle" ] && break
		nft delete rule ip nat PREROUTING handle $handle 2>/dev/null
		logger -t AdGuardHome "Debug: Deleted IPv4 TCP nftable rule"
	done

	# 只有在启用 IPv6 时才清理 IPv6 规则
	if [ "$ipv6_server" != "0" ]; then
		logger -t AdGuardHome "Debug: Clearing IPv6 nftables rules"
		while :; do
			local handle=$(nft -a list chain ip6 nat PREROUTING 2>/dev/null | grep -E "udp.*dport.*53.*redirect to.*:$OLD_PORT.*comment \"AdGuardHome_DNS_Redirect\"" | grep -oE "handle [0-9]+" | head -1 | awk '{print $2}')
			[ -z "$handle" ] && break
			nft delete rule ip6 nat PREROUTING handle $handle 2>/dev/null
			logger -t AdGuardHome "Debug: Deleted IPv6 UDP nftable rule"
		done
		
		while :; do
			local handle=$(nft -a list chain ip6 nat PREROUTING 2>/dev/null | grep -E "tcp.*dport.*53.*redirect to.*:$OLD_PORT.*comment \"AdGuardHome_DNS_Redirect\"" | grep -oE "handle [0-9]+" | head -1 | awk '{print $2}')
			[ -z "$handle" ] && break
			nft delete rule ip6 nat PREROUTING handle $handle 2>/dev/null
			logger -t AdGuardHome "Debug: Deleted IPv6 TCP nftable rule"
		done
	else
		logger -t AdGuardHome "Debug: Skipping IPv6 rules cleanup (disabled)"
	fi
	logger -t AdGuardHome "Info: Nftables rules cleared successfully"
}

service_triggers() {
	procd_add_reload_trigger "$CONFIGURATION"
	[ "$(uci get AdGuardHome.AdGuardHome.redirect)" == "redirect" ] && procd_add_reload_trigger firewall
}
isrunning(){
config_load "${CONFIGURATION}"
_isrunning
local r=$?
([ "$r" == "0" ] && echo "running") || ([ "$r" == "1" ] && echo "not run" ) || echo "no bin"
return $r
}
_isrunning(){
	config_get binpath $CONFIGURATION binpath "/etc/config/adGuardConfig/AdGuardHome"
	[ ! -f "$binpath" ] && return 2
	pgrep $binpath 2>&1 >/dev/null && return 0
	return 1
}
force_reload(){
	config_load "${CONFIGURATION}"
	_isrunning && procd_send_signal "$CONFIGURATION" || start
}
get_tz()
{
	SET_TZ=""

	if [ -e "/etc/localtime" ]; then
		return
	fi

	for tzfile in /etc/TZ /var/etc/TZ
	do
		if [ ! -e "$tzfile" ]; then
			continue
		fi

		tz="`cat $tzfile 2>/dev/null`"
	done

	if [ -z "$tz" ]; then
		return
	fi

	SET_TZ=$tz
}

rm_port53()
{
	local AdGuardHome_PORT=$(config_editor "dns.port" "" "$configpath" "1")
	dnsmasq_port=$(uci get dhcp.@dnsmasq[0].port 2>/dev/null)
	if [ -z "$dnsmasq_port" ]; then
	dnsmasq_port="53"
	fi
	if [ "$dnsmasq_port" == "$AdGuardHome_PORT" ]; then
		if [ "$dnsmasq_port" == "53" ]; then
			dnsmasq_port="1745"
		fi
	elif [ "$dnsmasq_port" == "53" ]; then
		return
	fi
	config_editor "dns.port" "$dnsmasq_port" "$configpath"
	uci set dhcp.@dnsmasq[0].port="53"
	uci commit dhcp
	/etc/init.d/dnsmasq reload
}

use_port53()
{
	local AdGuardHome_PORT=$(config_editor "dns.port" "" "$configpath" "1")
	dnsmasq_port=$(uci get dhcp.@dnsmasq[0].port 2>/dev/null)
	if [ -z "$dnsmasq_port" ]; then
		dnsmasq_port="53"
	fi
	if [ "$dnsmasq_port" == "$AdGuardHome_PORT" ]; then
		if [ "$dnsmasq_port" == "53" ]; then
			AdGuardHome_PORT="1745"
		fi
	elif [ "$AdGuardHome_PORT" == "53" ]; then
		return
	fi
	config_editor "dns.port" "53" "$configpath"
	uci set dhcp.@dnsmasq[0].port="$AdGuardHome_PORT"
	uci commit dhcp
	/etc/init.d/dnsmasq reload
}
do_redirect()
{
	config_load "${CONFIGURATION}"
	_do_redirect $1
}
_do_redirect()
{
	local section="$CONFIGURATION"
	args=""
	ipv6_server=1
	tcp_server=0
	enabled=$1
	if [ "$enabled" == "1" ]; then
		echo -n "1">/var/run/AdGredir
	else
		echo -n "0">/var/run/AdGredir
	fi
	config_get configpath $CONFIGURATION configpath "/etc/config/adGuardConfig/AdGuardHome.yaml"
	logger -t AdGuardHome "Debug: configpath=$configpath"
	
	AdGuardHome_PORT=$(config_editor "dns.port" "" "$configpath" "1")
	logger -t AdGuardHome "Debug: AdGuardHome_PORT from config_editor=$AdGuardHome_PORT"
	
	if [ -z "$AdGuardHome_PORT" ]; then
		logger -t AdGuardHome "Warning: Could not read DNS port from config_editor, trying grep method"
		AdGuardHome_PORT=$(grep -A 20 "^dns:" "$configpath" 2>/dev/null | grep "^[[:space:]]*port:" | head -1 | sed 's/.*port:[[:space:]]*//' | tr -d ' \r\n')
		logger -t AdGuardHome "Debug: AdGuardHome_PORT from grep=$AdGuardHome_PORT"
	fi
	
	if [ -z "$AdGuardHome_PORT" ]; then
		logger -t AdGuardHome "Warning: Trying awk method"
		AdGuardHome_PORT=$(awk '/^dns:/,0 { if (/^[[:space:]]+port:/) { gsub(/[^0-9]/, "", $2); print $2; exit } }' "$configpath" 2>/dev/null)
		logger -t AdGuardHome "Debug: AdGuardHome_PORT from awk=$AdGuardHome_PORT"
	fi
	
	if [ -z "$AdGuardHome_PORT" ]; then
		logger -t AdGuardHome "Warning: Trying sed method"
		AdGuardHome_PORT=$(sed -n '/^dns:/,/^[^[:space:]]/{/^[[:space:]]*port:/s/.*port:[[:space:]]*//p}' "$configpath" | head -1 | tr -d ' \r\n')
		logger -t AdGuardHome "Debug: AdGuardHome_PORT from sed=$AdGuardHome_PORT"
	fi
	
	if [ -z "$AdGuardHome_PORT" ]; then
		logger -t AdGuardHome "Error: All methods failed to read DNS port"
		AdGuardHome_PORT="0"
	else
		logger -t AdGuardHome "Success: Read DNS port=$AdGuardHome_PORT"
	fi
	
	config_get "redirect" "$section" "redirect" "none"
	logger -t AdGuardHome "Debug: redirect=$redirect, enabled=$enabled"
	uci get dhcp.@dnsmasq[0].port >/dev/null 2>&1 || uci set dhcp.@dnsmasq[0].port="53" >/dev/null 2>&1

	# 当停止服务时，总是清理规则
	if [ "$enabled" = "0" ]; then
		logger -t AdGuardHome "Info: Stopping service, clearing all AdGuardHome firewall rules"
		clear_iptable "$AdGuardHome_PORT" "$ipv6_server"
		stop_forward_dnsmasq "$AdGuardHome_PORT"
		rm_port53
		return 1
	fi

	# 当重定向方式改变时，清理旧规则
	if [ "$redirect" != "none" ]; then
		logger -t AdGuardHome "Debug: Clearing old redirect rules before setting new rules"
		clear_iptable "$AdGuardHome_PORT" "$ipv6_server"
		stop_forward_dnsmasq "$AdGuardHome_PORT"
		rm_port53
	fi

	# 添加新规则
	if [ "$AdGuardHome_PORT" == "0" ]; then
		logger -t AdGuardHome "Warning: AdGuardHome_PORT is 0, cannot add redirect rules"
		return 1
	fi
	
	if [ "$redirect" = "redirect" ]; then
		set_iptable $ipv6_server $tcp_server
	elif [ "$redirect" = "dnsmasq-upstream" ]; then
		set_forward_dnsmasq "$AdGuardHome_PORT"
	elif [ "$redirect" == "exchange" -a "$(uci get dhcp.@dnsmasq[0].port 2>/dev/null)" == "53" ]; then
		use_port53
	fi
}
get_filesystem()
{
# print out path filesystem
    echo $1 | awk '
    BEGIN{
    while (("mount"| getline ret) > 0)
    {
    split(ret,d);
    fs[d[3]]=d[5];
    m=index(d[1],":")
    if (m==0)
    {
        pt[d[3]]=d[1]
    }else{
        pt[d[3]]=substr(d[1],m+1)
    }}}{
    split($0,d,"/");
    if ("/" in fs)
    {
    result1=fs["/"];
    }
    if ("/" in pt)
    {
    result2=pt["/"];
    }
    for (i=2;i<=length(d);i++)
    {
       p[i]=p[i-1]"/"d[i];
       if (p[i] in fs)
        {
        result1=fs[p[i]];
        result2=pt[p[i]];
        }
    }
    if (result2 in fs){
        result=fs[result2]}
    else{
        result=result1}
    print(result);}'
}

config_editor()
{
	local yaml="$1"
	local value="$2"
	local file="$3"
	local ro="$4"
	if [ ! -f "$file" ]; then
		[ -z "$ro" ] && return 1
		return 1
	fi
	local line_num=0
	local found=0
	local yaml_key yaml_value
	yaml_key=$(echo "$yaml" | sed 's/\./ /g')
	local depth=0
	local max_depth=$(echo "$yaml_key" | wc -w)
	while IFS= read -r line; do
		line_num=$((line_num + 1))
		current_depth=$(echo "$yaml_key" | cut -d' ' -f$((depth+1)))
		if [ -z "$current_depth" ]; then
			break
		fi
		local pattern="^[[:space:]]*${current_depth}[[:space:]]*:"
		if echo "$line" | grep -qE "$pattern"; then
			depth=$((depth + 1))
			if [ "$depth" -eq "$max_depth" ]; then
				if [ -z "$ro" ]; then
					sed -i "${line_num}s/.*/  ${current_depth}: ${value}/" "$file"
					found=1
				else
					echo "$line" | sed 's/.*: *//'
					found=1
				fi
				break
			fi
		fi
	done < "$file"
	[ "$found" -eq 0 ] && [ -z "$ro" ] && return 1
	if [ "$found" -eq 1 ]; then
		return 0
	else
		return 1
	fi
}

check_dependencies()
{
	local missing=""
	command -v curl >/dev/null 2>&1 || command -v wget >/dev/null 2>&1 || missing="${missing}curl/wget "
	command -v awk >/dev/null 2>&1 || missing="${missing}awk "
	command -v sed >/dev/null 2>&1 || missing="${missing}sed "
	command -v grep >/dev/null 2>&1 || missing="${missing}grep "
	if [ -n "$missing" ]; then
		logger -t AdGuardHome "Missing dependencies:${missing}"
		echo "ERROR: Missing required tools:${missing}" >&2
		return 1
	fi
	return 0
}

boot_service() {
	rm /var/run/AdGserverdis >/dev/null 2>&1
	check_dependencies || {
		echo "Dependency check failed"
		return 1
	}
	config_load "${CONFIGURATION}"
	config_get waitonboot $CONFIGURATION waitonboot "0"
	config_get_bool enabled $CONFIGURATION enabled 0
	config_get binpath $CONFIGURATION binpath "/etc/config/adGuardConfig/AdGuardHome"
	[ -f "$binpath" ] && start_service
	if [ "$enabled" == "1" ] && [ "$waitonboot" == "1" ]; then
		procd_open_instance "waitnet"
		procd_set_param command "/usr/share/AdGuardHome/waitnet.sh"
		procd_close_instance
		echo "no net start pinging"
	fi
}

testbackup(){
config_load "${CONFIGURATION}"
if [ "$1" == "backup" ]; then
	backup
elif [ "$1" == "restore" ]; then
	restore
fi
}
restore()
{
	config_get workdir $CONFIGURATION workdir "/etc/config/adGuardConfig/workspace"
	config_get backupwdpath $CONFIGURATION backupwdpath "/etc/config/adGuardConfig/workspace"
	if [ ! -d "$backupwdpath/data" ]; then
		logger -t AdGuardHome "Backup directory not found: $backupwdpath/data"
		return 1
	fi
	if [ -d "$backupwdpath/data" ]; then
		cp -u -r -f $backupwdpath/data $workdir 2>/dev/null && \
			logger -t AdGuardHome "Restore completed from $backupwdpath" || \
			logger -t AdGuardHome "Restore failed"
	fi
}
backup() {
	config_get backupwdpath $CONFIGURATION backupwdpath "/etc/config/adGuardConfig/workspace"
	mkdir -p $backupwdpath/data
	config_get workdir $CONFIGURATION workdir "/etc/config/adGuardConfig/workspace"
	config_get backupfile $CONFIGURATION backupfile ""
	if [ ! -d "$workdir/data" ]; then
		logger -t AdGuardHome "Workdir data not found: $workdir/data"
		return 1
	fi
	for one in $backupfile; do
		while :; do
			if [ -d "$backupwdpath/data/$one" ]; then
				cpret=$(cp -u -r -f $workdir/data/$one $backupwdpath/data 2>&1)
			else
				cpret=$(cp -u -r -f $workdir/data/$one $backupwdpath/data/$one 2>&1)
			fi
			echo "$cpret"
			echo "$cpret" | grep -q "no space left on device"
			if [ "$?" == "0" ]; then
				echo "Disk full, retrying after deleting logs"
				del_querylog && continue
				rm -f -r $backupwdpath/data/filters
				rm -f -r $workdir/data/filters && continue
				echo "backup failed"
				logger -t AdGuardHome "Backup failed: disk full"
			fi
			break
		done
	done
	logger -t AdGuardHome "Backup completed to $backupwdpath"
}
start_service() {
	rm /var/run/AdGserverdis >/dev/null 2>&1
	config_load "${CONFIGURATION}"
	config_get binpath $CONFIGURATION binpath "/etc/config/adGuardConfig/AdGuardHome"
	config_get configpath $CONFIGURATION configpath "/etc/config/adGuardConfig/AdGuardHome.yaml"
	config_get workdir $CONFIGURATION workdir "/etc/config/adGuardConfig/workspace"
	config_get_bool enabled $CONFIGURATION enabled 0

	if [ ! -f "$binpath" ]; then
		logger -t AdGuardHome "Binary not found: $binpath"
		echo "ERROR: AdGuardHome binary not found" >&2
		_do_redirect 0
		/usr/share/AdGuardHome/update_core.sh 2>&1 >/tmp/AdGuardHome_update.log &
		exit 0
	fi

	if [ ! -f "$configpath" ]; then
		logger -t AdGuardHome "Config not found: $configpath"
		echo "WARNING: Config file not found, will use default" >&2
	fi

	if [ ! -d "$workdir" ]; then
		mkdir -p "$workdir" 2>/dev/null
		[ ! -d "$workdir" ] && {
			logger -t AdGuardHome "Cannot create workdir: $workdir"
			echo "ERROR: Cannot create work directory" >&2
			return 1
		}
	fi

	config_get hashpass $CONFIGURATION hashpass ""
	if [ -n "$hashpass" ]; then
		if [ -f "$configpath" ]; then
			config_editor "users.password" "$hashpass" "$configpath"
			uci set $CONFIGURATION.$CONFIGURATION.hashpass=""
		fi
	fi

	if [ "$enabled" == "0" ]; then
		_do_redirect 0
		return
	fi

	do_crontab

	config_get backupfile $CONFIGURATION backupfile ""
	mkdir -p $workdir/data
	if [ -n "$backupfile" ] && [ ! -d "$workdir/data" ]; then
		restore
	fi
	local cwdfs=$(get_filesystem $workdir)
	echo "workdir is a $cwdfs filesystem"
	if [ "$cwdfs" == "jffs2" ]; then
		echo "fs error ln db to tmp $workdir $cwdfs"
		logger "AdGuardHome" "warning db redirect to tmp"
		touch $workdir/data/stats.db
		if [ ! -L $workdir/data/stats.db ]; then
		mv -f $workdir/data/stats.db /tmp/stats.db 2>/dev/null
		ln -s /tmp/stats.db $workdir/data/stats.db 2>/dev/null
		fi
		touch $workdir/data/sessions.db
		if [ ! -L $workdir/data/sessions.db ]; then
		mv -f $workdir/data/sessions.db /tmp/sessions.db 2>/dev/null
		ln -s /tmp/sessions.db $workdir/data/sessions.db 2>/dev/null
		fi
	fi
	local ADDITIONAL_ARGS=""
	config_get binpath $CONFIGURATION binpath "/etc/config/adGuardConfig/AdGuardHome"

	mkdir -p ${binpath%/*}
	ADDITIONAL_ARGS="$ADDITIONAL_ARGS -c $configpath"
	ADDITIONAL_ARGS="$ADDITIONAL_ARGS -w $workdir"
	config_get httpport $CONFIGURATION httpport 3000
	ADDITIONAL_ARGS="$ADDITIONAL_ARGS -p $httpport"

	config_get upprotect $CONFIGURATION upprotect ""
	upprotect=$(echo "$upprotect" | sed 's/ /\\\n/g')
	echo -e "$upprotect">/lib/upgrade/keep.d/luci-app-adguardhome
	
	config_get logfile $CONFIGURATION logfile ""
	if [ -n "$logfile" ]; then
		ADDITIONAL_ARGS="$ADDITIONAL_ARGS -l $logfile"
	fi

	if [ ! -f "$binpath" ]; then
		_do_redirect 0
		/usr/share/AdGuardHome/update_core.sh 2>&1 >/tmp/AdGuardHome_update.log &
		exit 0
	fi

	config_get_bool verbose $CONFIGURATION verbose 0
	if [ "$verbose" -eq 1 ]; then
		ADDITIONAL_ARGS="$ADDITIONAL_ARGS -v"
	fi

	procd_open_instance
	get_tz
	if [ -n "$SET_TZ" ]; then
		procd_set_param env TZ="$SET_TZ"
	fi
	procd_set_param respawn ${respawn_threshold:-3600} ${respawn_timeout:-5} ${respawn_retry:-5}
	procd_set_param limits core="unlimited" nofile="65535 65535" cpu="100000"
	procd_set_param stderr 1
	procd_set_param command $binpath $ADDITIONAL_ARGS
	procd_set_param file "$configpath" "/etc/hosts" "/etc/config/AdGuardHome"
	procd_close_instance
	if [ -f "$configpath" ]; then
		_do_redirect 1
	else
		_do_redirect 0
		config_get "redirect" "AdGuardHome" "redirect" "none"
		if [ "$redirect" != "none" ]; then
			procd_open_instance "waitconfig"
			procd_set_param command "/usr/share/AdGuardHome/watchconfig.sh"
			procd_close_instance
			echo "no config start watching"
		fi
	fi
	echo "AdGuardHome service enabled"
	echo "luci enable switch=$enabled"
	(sleep 10 && [ -z "$(pgrep $binpath)" ] && logger "AdGuardHome" "no process in 10s cancel redirect" && _do_redirect 0 )&
}
reload_service()
{
	rm /var/run/AdGlucitest >/dev/null 2>&1
	echo "AdGuardHome reloading"
	start
}

del_querylog(){
local btarget=$(ls $backupwdpath/data | grep -F "querylog.json" | sort -r | head -n 1)
local wtarget=$(ls $workdir/data | grep -F "querylog.json" | sort -r | head -n 1)
if [ "$btarget"x == "$wtarget"x ]; then
	[ -z "$btarget" ] && return 1
	rm -f $workdir/data/$wtarget
	rm -f $backupwdpath/data/$btarget
	return 0
fi
if [ "$btarget" \> "$wtarget" ]; then
	rm -f $backupwdpath/data/$btarget
	return 0
else
	rm -f $workdir/data/$wtarget
	return 0
fi
}
stop_service()
{
	config_load "${CONFIGURATION}"
	config_get ipv6_server $CONFIGURATION ipv6_server "1"
	config_get tcp_server $CONFIGURATION tcp_server "0"
	config_get AdGuardHome_PORT $CONFIGURATION port "53"
	export AdGuardHome_PORT
	# _do_redirect 0 会根据 COMMENT 精确清理所有 AdGuardHome 规则
	_do_redirect 0
	do_crontab
	if [ "$1" != "nobackup" ]; then
		config_get backupfile $CONFIGURATION backupfile "0"
		if [ -n "$backupfile" ]; then
			backup
		fi
	fi
	echo "AdGuardHome service disabled"
	touch /var/run/AdGserverdis
}
boot() {
	rc_procd boot_service "$@"
	if eval "type service_started" 2>/dev/null >/dev/null; then
		service_started
	fi
}
test_crontab(){
config_load "${CONFIGURATION}"
do_crontab
}
do_crontab(){
	config_get_bool enabled $CONFIGURATION enabled 0
	config_get crontab $CONFIGURATION crontab ""
	local findstr default cronenable replace commit
	local cronreload=0
	local commit=0
	findstr="/usr/share/AdGuardHome/update_core.sh"
	default="30 3 * * * /usr/share/AdGuardHome/update_core.sh 2>&1"
	[ "$enabled" == "0" ] || [ "${crontab//autoupdate/}" == "$crontab" ] && cronenable=0 || cronenable=1
	crontab_editor
	
	config_get workdir $CONFIGURATION workdir "/etc/config/adGuardConfig/workspace"
	config_get lastworkdir $CONFIGURATION lastworkdir "/etc/config/adGuardConfig/workspace"
	findstr="/usr/share/AdGuardHome/tailto.sh [0-9]* \$(uci get AdGuardHome.AdGuardHome.workdir)/data/querylog.json"
	default="0 * * * * /usr/share/AdGuardHome/tailto.sh 2000 \$(uci get AdGuardHome.AdGuardHome.workdir)/data/querylog.json"
	[ "$enabled" == "0" ] || [ "${crontab//cutquerylog/}" == "$crontab" ] && cronenable=0 || cronenable=1
	crontab_editor
	
	config_get logfile $CONFIGURATION logfile ""
	config_get lastlogfile $CONFIGURATION lastlogfile ""
	findstr="/usr/share/AdGuardHome/tailto.sh [0-9]* \$(uci get AdGuardHome.AdGuardHome.logfile)"
	default="30 3 * * * /usr/share/AdGuardHome/tailto.sh 2000 \$(uci get AdGuardHome.AdGuardHome.logfile)"
	[ "$logfile" == "syslog" ] || [ "$logfile" == "" ] || [ "$enabled" == "0" ] || [ "${crontab//cutruntimelog/}" == "$crontab" ] && cronenable=0 || cronenable=1
	crontab_editor
	
	findstr="/usr/share/AdGuardHome/addhost.sh"
	default="0 * * * * /usr/share/AdGuardHome/addhost.sh"
	[ "$enabled" == "0" ] || [ "${crontab//autohost/}" == "$crontab" ] && cronenable=0 || cronenable=1
	crontab_editor
	[ "$cronenable" == "0" ] && /usr/share/AdGuardHome/addhost.sh "del" "noreload" || /usr/share/AdGuardHome/addhost.sh "" "noreload"

	findstr="/usr/share/AdGuardHome/gfw2adg.sh"
	default="30 3 * * * /usr/share/AdGuardHome/gfw2adg.sh"
	[ "$enabled" == "0" ] || [ "${crontab//autogfw/}" == "$crontab" ] && cronenable=0 || cronenable=1
	crontab_editor
	[ "$cronreload" -gt 0 ] && /etc/init.d/cron restart
}
crontab_editor(){
	local testline reload
	local line="$(grep "$findstr" $CRON_FILE)"
	[ -n "$replace" ] && [ -n "$line" ] && testline="$(echo "$line" | sed "s/$replace//g")" && [ "$testline" != "$line" ] && line="$testline" && reload="1" && replace="" 
	local first_char="$(echo "$line" | cut -c1)"
	if [ "$first_char" != "#" ]; then
		if [ $cronenable -eq 1 ]; then
			[ -z "$line" ] && line="$default" && reload="1"
			if [ -n "$reload" ]; then
				sed -i "\,$findstr,d" $CRON_FILE
				echo "$line" >> $CRON_FILE
				cronreload=$((cronreload+1))
			fi
		elif [ -n "$line" ]; then
			sed -i "\,$findstr,d" $CRON_FILE
			echo "#$line" >> $CRON_FILE
			cronreload=$((cronreload+1))
		fi
	else
		if [ $cronenable -eq 1 ]; then
			sed -i "\,$findstr,d" $CRON_FILE
			echo "$line" | cut -c2- >> $CRON_FILE
			cronreload=$((cronreload+1))
		elif [ -z "$reload" ]; then
			sed -i "\,$findstr,d" $CRON_FILE
			echo "$line" >> $CRON_FILE
		fi
	fi
}